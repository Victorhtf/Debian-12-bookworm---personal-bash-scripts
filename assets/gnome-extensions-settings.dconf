[Logo-menu]
menu-button-icon-image=2
menu-button-icon-size=23
symbolic-icon=true
use-custom-icon=false

[auto-move-windows]
application-list=['steam.desktop:2', 'com.valvesoftware.SteamLink.desktop:2', 'com.stremio.Stremio.desktop:2', 'com.usebottles.bottles.desktop:2', 'com.discordapp.Discord.desktop:2', 'vlc.desktop:3', 'de.haeckerfelix.Shortwave.desktop:3', 'io.github.seadve.Mousai.desktop:3']

[blur-my-shell]
rounded-blur-found=false
settings-version=2

[blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[blur-my-shell/applications]
pipeline='pipeline_default'

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
pipeline='pipeline_default_rounded'
sigma=30
static-blur=true
style-dash-to-dock=0

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'

[blur-my-shell/panel]
brightness=0.59999999999999998
corner-radius=0
pipeline='pipeline_default'
sigma=30

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[caffeine]
cli-toggle=false
indicator-position-max=3

[clipboard-indicator]
history-size=300
keep-selected-on-clear=true
move-item-first=true
open-at-cursor=true
paste-on-select=true
strip-text=true
toggle-menu=['<Super>v']

[com/github/hermes83/compiz-windows-effect]
friction=5.0
last-version=29
mass=50.0
preset='E'
speedup-factor-divider=15.0
spring-k=4.2000000000000002

[coverflowalttab]
switcher-background-color=(1.0, 1.0, 1.0)
switcher-looping-method='Carousel'
switcher-style='Coverflow'

[dash-to-dock]
app-hotkey-1=@as []
app-hotkey-10=@as []
app-hotkey-2=@as []
app-hotkey-3=@as []
app-hotkey-4=@as []
app-hotkey-5=@as []
app-hotkey-6=@as []
app-hotkey-7=@as []
app-hotkey-8=@as []
app-hotkey-9=@as []
app-shift-hotkey-1=@as []
app-shift-hotkey-10=@as []
app-shift-hotkey-2=@as []
app-shift-hotkey-3=@as []
app-shift-hotkey-4=@as []
app-shift-hotkey-5=@as []
app-shift-hotkey-6=@as []
app-shift-hotkey-7=@as []
app-shift-hotkey-8=@as []
app-shift-hotkey-9=@as []
background-opacity=0.80000000000000004
custom-theme-shrink=false
dash-max-icon-size=48
dock-position='BOTTOM'
height-fraction=0.90000000000000002
hot-keys=false
isolate-locations=true
isolate-workspaces=true
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'
scroll-action='cycle-windows'
show-mounts=false
show-mounts-only-mounted=true
show-trash=false

[emoji-copy]
always-show=false
recently-used=['😂', '❤️', '😍', '😭', '😊', '😒', '😘', '😩', '🤔', '☺️', '👌']

[extension-list]
extension-button=false
filter-button=false
homepage-button=false
ignore-button=false
remove-button=false

[gtile]
auto-close=false
follow-cursor=false

[just-perfection]
accessibility-menu=false
activities-button=true
clock-menu=true
panel=true
panel-in-overview=true
quick-settings=true
quick-settings-backlight=true
support-notifier-type=0
type-to-search=true
window-demands-attention-focus=true
window-maximized-on-create=false
workspace-thumbnail-to-main-view=false

[libpanel]
layout=[['gnome@main', 'extension-list@tu.berry/main', 'quick-settings-audio-panel@rayzeq.github.io/main']]
single-column=true

[lockkeys]
capslock-indicator='never'
capslock-notification='off'
numlock-indicator='never'
numlock-notification='off'

[mediacontrols]
extension-position='Left'

[quick-settings-audio-panel]
add-button-applications-output-reset-to-default=false
always-show-input-volume-slider=false
ignore-css=false
master-volume-sliders-show-current-device=false
panel-type='independent-panel'
profiles-renames={'Raptor Lake-P/U/H cAVS': {'off': ('Off', 'Off'), 'pro-audio': ('Pro Audio', 'Pro Audio'), 'HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)': ('Play HiFi quality Music (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)', 'Play HiFi quality Music (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)'), 'HiFi (HDMI1, HDMI2, HDMI3, Headphones, Mic1, Mic2)': ('Play HiFi quality Music (HDMI1, HDMI2, HDMI3, Headphones, Mic1, Mic2)', 'Play HiFi quality Music (HDMI1, HDMI2, HDMI3, Headphones, Mic1, Mic2)')}}
remove-output-volume-slider=false
version=2

[quick-settings-tweaks]
datemenu-disable-menu=false
datemenu-hide-left-box=true
dnd-quick-toggle-indicator-position='date-menu'
media-contorl-show-pause-button=true
media-enabled=true
notifications-compact=true
notifications-enabled=true
overlay-menu-enabled=false
system-indicator-layout-enabled=false
system-indicator-privacy-indicator-style='default'
system-indicator-screen-recording-indicator-use-accent=false
toggles-layout-enabled=true
unsafe-quick-toggle-enabled=true
unsafe-quick-toggle-last-state=false
volume-mixer-enabled=false
weather-enabled=false

[space-bar/appearance]
application-styles='.space-bar {\n  -natural-hpadding: 12px;\n}\n\n.space-bar-workspace-label.active {\n  margin: 0 4px;\n  background-color: rgba(255,255,255,0.3);\n  color: rgba(255,255,255,1);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}\n\n.space-bar-workspace-label.inactive {\n  margin: 0 4px;\n  background-color: rgba(0,0,0,0);\n  color: rgba(255,255,255,1);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}\n\n.space-bar-workspace-label.inactive.empty {\n  margin: 0 4px;\n  background-color: rgba(0,0,0,0);\n  color: rgba(255,255,255,0.5);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}'

[space-bar/behavior]
always-show-numbers=false
position='left'
smart-workspace-names=false

[space-bar/state]
version=34

[tilingshell]
edge-tiling-mode='default'
inner-gaps=uint32 16
last-version-name-installed='17.3'
layouts-json='[{"id":"Layout 1","tiles":[{"x":0,"y":0,"width":0.22,"height":0.5,"groups":[1,2]},{"x":0,"y":0.5,"width":0.22,"height":0.5,"groups":[1,2]},{"x":0.22,"y":0,"width":0.56,"height":1,"groups":[2,3]},{"x":0.78,"y":0,"width":0.22,"height":0.5,"groups":[3,4]},{"x":0.78,"y":0.5,"width":0.22,"height":0.5,"groups":[3,4]}]},{"id":"Layout 2","tiles":[{"x":0,"y":0,"width":0.22,"height":1,"groups":[1]},{"x":0.22,"y":0,"width":0.56,"height":1,"groups":[1,2]},{"x":0.78,"y":0,"width":0.22,"height":1,"groups":[2]}]},{"id":"Layout 3","tiles":[{"x":0,"y":0,"width":0.33,"height":1,"groups":[1]},{"x":0.33,"y":0,"width":0.67,"height":1,"groups":[1]}]},{"id":"Layout 4","tiles":[{"x":0,"y":0,"width":0.67,"height":1,"groups":[1]},{"x":0.67,"y":0,"width":0.33,"height":1,"groups":[1]}]}]'
overridden-settings="{\"org.gnome.mutter.keybindings\":{\"toggle-tiled-right\":\"['<Super>Right']\",\"toggle-tiled-left\":\"['<Super>Left']\"},\"org.gnome.desktop.wm.keybindings\":{\"maximize\":\"['<Super>Up']\",\"unmaximize\":\"['<Super>Down', '<Alt>F5']\"},\"org.gnome.mutter\":{\"edge-tiling\":\"true\"}}"
selected-layouts=[['Layout 1', 'Layout 1'], ['Layout 3', 'Layout 1'], ['Layout 3', 'Layout 1']]
show-indicator=true
window-use-custom-border-color=false

[trayIconsReloaded]
icon-margin-horizontal=0
icon-margin-vertical=1
tray-margin-left=1

[wack-lockscreen-clock]
lockscreen-mode='wack'
